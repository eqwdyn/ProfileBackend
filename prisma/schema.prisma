generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id Int @id @default(autoincrement())

  name String
  description String
  skills ProfileSkill[]
  experiences ProfileExperience[]
  projects ProfileProject[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Skill {
  id Int @id @default(autoincrement())

  name String @unique
  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId Int
  skillId Int

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

model Experience {
  id Int @id @default(autoincrement())

  company String @unique
  position String 
  profiles ProfileExperience[]
  achievements String[]

  startDate DateTime @map("start_date")
  endDate DateTime @map("end_date")

  @@map("experiences")
}

model ProfileExperience {
  profileId Int
  experienceId Int
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([profileId, experienceId])
  @@map("profile_experiences")
}

model Project {
  id Int @id @default(autoincrement())
  name String
  description String
  profiles ProfileProject[]

  @@map("projects")
}

model ProfileProject {
  profileId Int
  projectId Int
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([profileId, projectId])
  @@map("profile_projects")
}
